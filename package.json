{
  "name": "insights",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "verify-hook": "vitest run tools/hook.test.ts",
    "check:boundaries": "depcruise packages apps --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.7.0",
    "husky": "9.1.7",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
